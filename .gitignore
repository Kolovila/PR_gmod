# Оружейные аддоны из Workshop (tools/workshop, папка addons/ws_weapons): в git только их Lua,
# модели, звуки и текстуры (~25 ГБ) — локально; восстанавливаются tools/workshop/rebuild.ps1
/addons/ws_*/*
!/addons/ws_*/lua/

__pycache__/

# Навмеш карты (tools/selftest -Suite navzone, ~2,8 ч): 150 МБ — больше лимита GitHub; живёт локально,
# deploy.ps1 и тестовые копии забирают его вместе с режимом
/gamemodes/testgm/content/maps/*.nav
